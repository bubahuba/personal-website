{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		"paths": {
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"],
			"#lib/components": ["./src/lib/components"],
			"#lib/components/*": ["./src/lib/components/*"],
			"#lib/utils": ["./src/lib/utils.ts"],
			"#lib/hooks": ["./src/lib/hooks"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
